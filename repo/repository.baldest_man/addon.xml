  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Install bald_man from GitHub</summary>
    <description lang="en_GB">Repository for the bald_man Kodi video addon. Add this source once, install the repo zip, then install bald_man from Video add-ons.</description>
    <platform>all</platform>
  </extension>
</addon>
