<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="repository.baldest_man"
       name="bald_man Repository"
       version="1.0.0"
       provider-name="bald_man">
  <extension point="xbmc.addon.repository" name="bald_man Add-ons">
    <dir>
      <info compressed="false">https://raw.githubusercontent.com/brucemcduck/plugin.video.baldest_man/master/repo/zips/addons.xml</info>
      <checksum>https://raw.githubusercontent.com/brucemcduck/plugin.video.baldest_man/master/repo/zips/addons.xml.md5</checksum>
      <datadir zip="true">https://raw.githubusercontent.com/brucemcduck/plugin.video.baldest_man/master/repo/zips/</datadir>
    </dir>
